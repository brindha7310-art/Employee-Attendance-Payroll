
<mxfile host="app.diagrams.net">
  <diagram name="System Architecture">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="user" value="ADMIN / USER&#xa;Login and Manage System" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="350" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="frontend" value="FRONTEND&#xa;HTML - CSS - JavaScript&#xa;Login | Dashboard | Employees&#xa;Attendance | Payroll | Reports" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="350" y="190" width="450" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="backend" value="BACKEND&#xa;Java - Spring Boot&#xa;Employee Controller&#xa;Attendance Controller&#xa;Business Logic and REST APIs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="410" width="450" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="database" value="DATABASE&#xa;MySQL&#xa;Employee Table&#xa;Attendance Records Table" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="350" y="660" width="450" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="python" value="DATA ANALYSIS&#xa;Python&#xa;Database Retrieval&#xa;Data Preprocessing&#xa;Charts and Reports" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="850" y="660" width="280" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="a1" value="User Interaction" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="user" target="frontend">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a2" value="HTTP Requests / Responses" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="frontend" target="backend">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a3" value="JPA / SQL Operations" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="backend" target="database">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a4" value="MySQL Connector" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="database" target="python">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
